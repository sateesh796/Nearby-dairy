# Near by Dairy — environment variables
# Copy this file to .env and fill in real values when you're ready to move
# past the in-memory MVP. None of these are required to run the demo.

# --- Maps / GPS -------------------------------------------------------
# Used to replace the built-in SVG-free distance calculation with a real
# map view (pins, routes) on the Buffalo, Milk, and Doctors screens.
VITE_GOOGLE_MAPS_API_KEY=
# or, if using Mapbox instead:
VITE_MAPBOX_ACCESS_TOKEN=

# --- Backend API --------------------------------------------------------
# Base URL of your Node/Express (or other) backend once listings, offers,
# chat, and users move out of React state and into a real database.
VITE_API_BASE_URL=http://localhost:4000/api

# --- Authentication -------------------------------------------------------
# Firebase Authentication project config (if you choose Firebase over a
# custom JWT backend).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

# --- Media storage --------------------------------------------------------
# Buffalo photos/videos and doctor profile photos.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# --- Video consultation ---------------------------------------------------
# The demo's video call screen is UI-only. Wire it to a real WebRTC signaling
# server (or a hosted provider like Twilio/Agora/Daily) via this URL.
VITE_VIDEO_SIGNALING_URL=
